{
  "name": "good-dog-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "emulators": "bash scripts/emulators.sh",
    "seed": "node scripts/seed.mjs",
    "grant": "node scripts/grant-access.mjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-good-dog-rules --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "build:preview": "vite build --mode emulator",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build --mode demo",
    "test:e2e:demo": "E2E_DEMO=1 playwright test"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@mwilliams/ui": "file:vendor/mwilliams-ui-1.0.0.tgz",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.4.0",
    "firebase": "^13.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  }
}

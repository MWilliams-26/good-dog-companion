// Cloudflare deploy of the public demo build (static assets only, no backend).
// Build command: npm run build:demo   Deploy command: npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "good-dog-companion",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
